{
  "name": "@touch-stay/ui-library",
  "version": "0.1.0",
  "private": false,
  "keywords": [
    "touch-stay",
    "ui-library",
    "vue",
    "ui",
    "components",
    "primevue",
    "tailwind"
  ],
  "homepage": "https://github.com/touch-stay/ui-library#readme",
  "bugs": {
    "url": "https://github.com/touch-stay/ui-library/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/touch-stay/ui-library.git"
  },
  "license": "MIT",
  "author": {
    "name": "David Kulhanek",
    "email": "davidkulh182@gmail.com",
    "url": "https://github.com/d2a8k3u"
  },
  "sideEffects": [
    "dist/assets/theme/index.css",
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/button.js"
    },
    "./toolbar": {
      "types": "./dist/components/toolbar/index.d.ts",
      "import": "./dist/toolbar.js"
    },
    "./theme": {
      "default": "./dist/assets/theme/index.css"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "button": [
        "dist/components/button/index.d.ts"
      ],
      "toolbar": [
        "dist/components/toolbar/index.d.ts"
      ],
      "index": [
        "dist/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config vite.config.dev.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,vue,css,html,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@iconify/json": "^2.2.392",
    "@iconify/tailwind4": "^1.0.6",
    "@prettier/plugin-oxc": "^0.0.4",
    "@tailwindcss/vite": "^4.1.14",
    "@tsconfig/node24": "^24.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/eslint-plugin": "^1.3.13",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "@vue/typescript": "^1.8.20",
    "eslint": "^9.33.0",
    "eslint-plugin-oxlint": "~1.11.0",
    "eslint-plugin-vue": "~10.4.0",
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "jiti": "^2.5.1",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.4",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.11.0",
    "prettier": "3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.4.1",
    "start-server-and-test": "^2.1.2",
    "tailwind-classify": "^0.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.0",
    "vite": "npm:rolldown-vite@latest",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-plugin-static-copy": "^3.1.4",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.22",
    "vue-tsc": "^3.1.0"
  },
  "peerDependencies": {
    "primeicons": ">=7",
    "primevue": ">=4",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "primeicons": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.8.1+sha512.c50088ba998c67b8ca8c99df8a5e02fd2ae2e2b29aaf238feaa9e124248d3f48f9fb6db2424949ff901cffbb5e0f0cc1ad6aedb602cd29450751d11c35023677",
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
